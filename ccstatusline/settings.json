{
  "version": 4,
  "lines": [
    [
      {
        "id": "repo-icon",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "📁 ",
        "merge": "no-padding"
      },
      {
        "id": "repo",
        "type": "git-root-dir",
        "color": "hex:9485D6"
      },
      {
        "id": "repo-slash",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "/",
        "merge": "no-padding"
      },
      {
        "id": "sep-branch",
        "type": "separator"
      },
      {
        "id": "git-branch-top",
        "type": "git-branch",
        "color": "hex:9485D6"
      },
      {
        "id": "sep-delta",
        "type": "separator"
      },
      {
        "id": "delta-label",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "Δ",
        "merge": "no-padding"
      },
      {
        "id": "git-changes-top",
        "type": "git-changes",
        "color": "hex:9485D6"
      },
      {
        "id": "sep-pr",
        "type": "separator"
      },
      {
        "id": "pr",
        "type": "git-review",
        "color": "hex:C6E472",
        "rawValue": true,
        "metadata": {
          "hide": "no-git,no-data,title"
        }
      },
      {
        "id": "sep-cache",
        "type": "separator"
      },
      {
        "id": "cache-label",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "Cache ",
        "merge": "no-padding"
      },
      {
        "id": "cache-timer",
        "type": "cache-timer",
        "color": "hex:AEE8F4",
        "rawValue": true,
        "metadata": {
          "ttlSeconds": "3600"
        }
      }
    ],
    [
      {
        "id": "0",
        "type": "custom-text",
        "color": "hex:64D2E8",
        "customText": "🤖 ",
        "merge": "no-padding"
      },
      {
        "id": "1",
        "type": "model",
        "color": "hex:64D2E8",
        "rawValue": true,
        "merge": "no-padding"
      },
      {
        "id": "1e-open",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "(",
        "merge": "no-padding"
      },
      {
        "id": "1e",
        "type": "thinking-effort",
        "color": "hex:64D2E8",
        "rawValue": true,
        "merge": "no-padding"
      },
      {
        "id": "1e-close",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": ")"
      },
      {
        "id": "2",
        "type": "separator"
      },
      {
        "id": "2b",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "Ctx ",
        "merge": "no-padding"
      },
      {
        "id": "3a",
        "type": "context-length",
        "color": "hex:C6E472",
        "bold": true,
        "rawValue": true
      },
      {
        "id": "ctx-warn",
        "type": "custom-command",
        "commandPath": "~/.config/ccstatusline/ctx-warn.sh",
        "preserveColors": true,
        "timeout": 1000
      },
      {
        "id": "3b",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "(",
        "merge": "no-padding"
      },
      {
        "id": "3",
        "type": "context-percentage-usable",
        "color": "hex:C6E472",
        "bold": true,
        "rawValue": true
      },
      {
        "id": "3bc",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": ")",
        "merge": "no-padding"
      },
      {
        "id": "4",
        "type": "separator"
      },
      {
        "id": "7c",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "💰 ",
        "merge": "no-padding"
      },
      {
        "id": "7d",
        "type": "session-cost",
        "color": "hex:AEE8F4",
        "rawValue": true
      },
      {
        "id": "sep-xu",
        "type": "separator"
      },
      {
        "id": "xu-label",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": "💳 ",
        "merge": "no-padding"
      },
      {
        "id": "xu-util",
        "type": "extra-usage-utilization",
        "color": "hex:AEE8F4",
        "rawValue": true,
        "metadata": {
          "display": "progress-short",
          "cursor": "true"
        }
      },
      {
        "id": "xu-sp",
        "type": "custom-text",
        "customText": "(",
        "merge": "no-padding",
        "color": "hex:9485D6"
      },
      {
        "id": "xu-used",
        "type": "extra-usage-used",
        "color": "hex:9485D6",
        "rawValue": true,
        "merge": "no-padding"
      },
      {
        "id": "xu-close",
        "type": "custom-text",
        "color": "hex:9485D6",
        "customText": ")",
        "merge": "no-padding"
      }
    ]
  ],
  "flexMode": "full",
  "compactThreshold": 60,
  "colorLevel": 3,
  "inheritSeparatorColors": false,
  "globalBold": false,
  "powerline": {
    "enabled": false,
    "separators": [""],
    "separatorInvertBackground": [false],
    "startCaps": [],
    "endCaps": [],
    "autoAlign": false
  }
}
